<Window x:Class="YoutubeDownloader.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사용 가이드 및 도움말"
        Icon="app.ico"
        Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource CanvasBgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{StaticResource AccentRedBrush}" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                <Path Data="M 0,0 L 7,4.5 L 0,9 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1.5,0,0,0"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="YouGrab v2.0 가이드" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="주요 기능 및 사용 방법 안내" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Content List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 0. 개발자 정보 -->
                <Border Style="{StaticResource SlimCardPanel}" Margin="0,0,0,8" Padding="10" Background="#F8FAFC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="개발자: BJS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="버전: v2.0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="빌드일: 2026.08.03" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="Engine: C++ Core" FontSize="11" Foreground="{StaticResource AccentRedBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. 기본 사용법 -->
                <Border Style="{StaticResource SlimCardPanel}" Margin="0,0,0,8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="기본 사용 방법" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentRedBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="1. 유튜브 영상 주소를 복사 후 [붙여넣기] 클릭" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="2. 원하는 화질 및 부가 옵션 선택" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="3. [다운로드 시작] 버튼 클릭 시 자동 다운로드 진행" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 2. 화질 선택 -->
                <Border Style="{StaticResource SlimCardPanel}" Margin="0,0,0,8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="화질 선택 (Quality)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="• Best (최고): 원본 최상위 화질 자동 선택" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="• 2160p / 1440p / 1080p / 720p: 해상도 지정 수신" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 3. 쿠키 설정 -->
                <Border Style="{StaticResource SlimCardPanel}" Margin="0,0,0,8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="쿠키 연동 (Cookie Session)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="• 기본값(none): 계정 정보나 브라우저 쿠키를 전혀 참조하지 않고 다운로드합니다." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="• 브라우저 선택: 유튜브의 봇 검증(차단)을 회피하기 위해 본인 로컬 PC 세션을 일시 참조할 수 있습니다. 개인 계정 정보는 외부로 전송되거나 저장되지 않으므로 안심하고 사용하셔도 됩니다." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 4. 부가 기능 -->
                <Border Style="{StaticResource SlimCardPanel}" Margin="0,0,0,8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="부가 옵션 안내" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="• 자막 (.srt): 한국어/영어 자막 파일 함께 다운로드" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="• 새로 받기: 이미 다운로드한 이력이 있어도 강제 재다운로드" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 5. 엔진 안내 -->
                <Border Style="{StaticResource SlimCardPanel}" Padding="10">
                    <StackPanel>
                        <TextBlock Text="하이브리드 코어 시스템" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="C++ Win32 백엔드 엔진과 yt-dlp 파이프라인이 결합하여 빠른 처리 속도와 높은 안정성을 제공합니다." TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <!-- 6. 문의 / 피드백 -->
                <Border Style="{StaticResource SlimCardPanel}" Padding="10" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="문의 및 피드백" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Image Source="Resources/kakao_qr.png" Width="100" Height="100" Margin="0,0,12,0" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="카카오 오픈채팅으로" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="문의 및 버그 제보를" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="남겨주실 수 있습니다." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock FontSize="11">
                                    <Hyperlink NavigateUri="https://open.kakao.com/o/pBru28Gi"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        오픈채팅 바로가기
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Close Button -->
        <Button Grid.Row="4" Content="확인" Height="30" Width="100" HorizontalAlignment="Right" Command="{Binding CloseCommand}"/>
    </Grid>
</Window>
