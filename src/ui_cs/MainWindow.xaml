<Window x:Class="YoutubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Downloader v2.0"
        Height="640" Width="720"
        MinHeight="560" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Window.Resources>
        <!-- 섹션 레이블 스타일 -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,6"/>
            <Setter Property="TextTransform" Value="Uppercase"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 헤더 -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>   <!-- URL 입력 -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>   <!-- 화질 선택 -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>   <!-- 옵션 (쿠키/자막/강제재다운) -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>   <!-- 저장 경로 -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>   <!-- 다운로드 버튼 -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>   <!-- 진행 상황 -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>      <!-- 로그 콘솔 -->
        </Grid.RowDefinitions>

        <!-- ══ 헤더 ══════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="▶" Foreground="{StaticResource AccentRedBrush}"
                           FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="YouTube Downloader"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="v2.0  ·  C# WPF + C++ Core + yt-dlp"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" x:Name="BtnOpenFolder" Content="📁 완료 폴더 열기"
                    VerticalAlignment="Center" Padding="12,8"
                    Click="BtnOpenFolder_Click"/>
        </Grid>

        <!-- ══ URL 입력 ══════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="유튜브 URL" Style="{StaticResource SectionLabel}"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtUrl"
                             Height="38"
                             VerticalContentAlignment="Center"
                             Text="" FontSize="13"/>
                    <Button Grid.Column="2" Content="📋 붙여넣기"
                            Height="38" Padding="12,0"
                            Click="BtnPaste_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ══ 화질 선택 ═════════════════════════════════════ -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="화질 선택" Style="{StaticResource SectionLabel}"/>
                <WrapPanel x:Name="QualityPanel" Orientation="Horizontal">
                    <RadioButton x:Name="RdoBest"  Content="Best (최고)"  Style="{StaticResource QualityRadio}" Margin="0,0,6,0" IsChecked="True" GroupName="Quality" Tag="best"/>
                    <RadioButton x:Name="Rdo4K"    Content="2160p (4K)"  Style="{StaticResource QualityRadio}" Margin="0,0,6,0" GroupName="Quality" Tag="2160p"/>
                    <RadioButton x:Name="Rdo2K"    Content="1440p (2K)"  Style="{StaticResource QualityRadio}" Margin="0,0,6,0" GroupName="Quality" Tag="1440p"/>
                    <RadioButton x:Name="Rdo1080"  Content="1080p (FHD)" Style="{StaticResource QualityRadio}" Margin="0,0,6,0" GroupName="Quality" Tag="1080p"/>
                    <RadioButton x:Name="Rdo720"   Content="720p (HD)"   Style="{StaticResource QualityRadio}" Margin="0,0,6,0" GroupName="Quality" Tag="720p"/>
                    <RadioButton x:Name="Rdo480"   Content="480p"        Style="{StaticResource QualityRadio}" Margin="0,0,6,0" GroupName="Quality" Tag="480p"/>
                    <RadioButton x:Name="Rdo360"   Content="360p"        Style="{StaticResource QualityRadio}" GroupName="Quality" Tag="360p"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ══ 옵션 ════════════════════════════════════════════ -->
        <Border Grid.Row="6" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" x:Name="ChkSub"
                          Content="자막 저장 (.srt)"
                          VerticalAlignment="Center"/>
                <CheckBox Grid.Column="2" x:Name="ChkForce"
                          Content="강제 재다운로드"
                          VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="쿠키 브라우저:"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" FontSize="12"/>
                <ComboBox Grid.Column="6" x:Name="CboCookie"
                          SelectedIndex="0" MinWidth="90">
                    <ComboBoxItem Content="none"/>
                    <ComboBoxItem Content="edge"/>
                    <ComboBoxItem Content="chrome"/>
                    <ComboBoxItem Content="firefox"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- ══ 저장 경로 ══════════════════════════════════════ -->
        <Border Grid.Row="8" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="저장 경로" Style="{StaticResource SectionLabel}"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtOutput"
                             Height="38" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="찾아보기"
                            Height="38" Padding="12,0"
                            Click="BtnBrowse_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ══ 다운로드 버튼 ══════════════════════════════════ -->
        <Button Grid.Row="10" x:Name="BtnAction"
                Content="🚀  다운로드 시작"
                Style="{StaticResource PrimaryButton}"
                Click="BtnAction_Click"/>

        <!-- ══ 진행 상황 ═══════════════════════════════════════ -->
        <Border Grid.Row="12" Style="{StaticResource CardPanel}" x:Name="ProgressPanel" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtProgressFile"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" x:Name="TxtProgressPct"
                               Foreground="{StaticResource AccentRedBrush}"
                               FontWeight="Bold" FontSize="12"/>
                </Grid>
                <ProgressBar x:Name="PbProgress" Margin="0,8,0,4"
                             Value="0" Maximum="100"/>
                <TextBlock x:Name="TxtProgressMeta"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- ══ 로그 콘솔 ══════════════════════════════════════ -->
        <Border Grid.Row="14" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📋  로그 콘솔" Style="{StaticResource SectionLabel}"
                               VerticalAlignment="Center" Margin="0"/>
                    <Button Grid.Column="1" Content="클리어" Padding="8,4" FontSize="11"
                            Click="BtnClearLog_Click"/>
                    <Button Grid.Column="3" Content="복사" Padding="8,4" FontSize="11"
                            Click="BtnCopyLog_Click"/>
                </Grid>
                <TextBox Grid.Row="1" x:Name="TxtLog"
                         Background="#FF0D0D0D"
                         Foreground="#FFD4D4D4"
                         FontFamily="Consolas" FontSize="11"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         MinHeight="120"
                         BorderThickness="0"
                         Padding="8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
