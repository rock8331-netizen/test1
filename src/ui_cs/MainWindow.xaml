<Window x:Class="YoutubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Downloader v2.0"
        Height="560" Width="660"
        MinHeight="500" MinWidth="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBgBrush}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header Banner -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>   <!-- URL Input Card -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>   <!-- Quality Options Card -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>   <!-- Options Row -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>   <!-- Output Folder Card -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>   <!-- Action Button -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>   <!-- Progress Panel -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>      <!-- Terminal Log Console -->
        </Grid.RowDefinitions>

        <!-- ══ Header Banner ══════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource AccentRedBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                    <Path Data="M 0,0 L 10,6 L 0,12 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="YouTube Downloader"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="C# WPF UI · C++ Core · yt-dlp Backend"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10.5" FontWeight="Medium"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" x:Name="BtnOpenFolder" Content="📁 완료 폴더 열기"
                    VerticalAlignment="Center" Padding="10,0" Height="30" FontSize="11.5"
                    Click="BtnOpenFolder_Click"/>
        </Grid>

        <!-- ══ URL Input Card ══════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource SlimCardPanel}">
            <StackPanel>
                <TextBlock Text="YOUTUBE LINK" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtUrl" Height="32" FontSize="12"/>
                    <Button Grid.Column="2" Content="📋 붙여넣기" Height="32" Padding="10,0" Click="BtnPaste_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ══ Quality Options Card ════════════════════════════════════ -->
        <Border Grid.Row="4" Style="{StaticResource SlimCardPanel}">
            <StackPanel>
                <TextBlock Text="VIDEO QUALITY" Style="{StaticResource SectionHeader}"/>
                <WrapPanel x:Name="QualityPanel" Orientation="Horizontal">
                    <RadioButton x:Name="RdoBest"  Content="Best (최고)"  Style="{StaticResource QualityPillRadio}" IsChecked="True" GroupName="Quality" Tag="best"/>
                    <RadioButton x:Name="Rdo4K"    Content="2160p (4K)"  Style="{StaticResource QualityPillRadio}" GroupName="Quality" Tag="2160p"/>
                    <RadioButton x:Name="Rdo2K"    Content="1440p (2K)"  Style="{StaticResource QualityPillRadio}" GroupName="Quality" Tag="1440p"/>
                    <RadioButton x:Name="Rdo1080"  Content="1080p (FHD)" Style="{StaticResource QualityPillRadio}" GroupName="Quality" Tag="1080p"/>
                    <RadioButton x:Name="Rdo720"   Content="720p (HD)"   Style="{StaticResource QualityPillRadio}" GroupName="Quality" Tag="720p"/>
                    <RadioButton x:Name="Rdo480"   Content="480p"        Style="{StaticResource QualityPillRadio}" GroupName="Quality" Tag="480p"/>
                    <RadioButton x:Name="Rdo360"   Content="360p"        Style="{StaticResource QualityPillRadio}" GroupName="Quality" Tag="360p"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ══ Options Row ═════════════════════════════════════════════ -->
        <Border Grid.Row="6" Style="{StaticResource SlimCardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" x:Name="ChkSub" Content="자막 저장 (.srt)" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="2" x:Name="ChkForce" Content="새로 받기 (기록 무시)" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="쿠키 브라우저:"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="6" x:Name="CboCookie" SelectedIndex="0" MinWidth="90" Height="28">
                    <ComboBoxItem Content="none"/>
                    <ComboBoxItem Content="edge"/>
                    <ComboBoxItem Content="chrome"/>
                    <ComboBoxItem Content="firefox"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- ══ Output Folder Card ══════════════════════════════════════ -->
        <Border Grid.Row="8" Style="{StaticResource SlimCardPanel}">
            <StackPanel>
                <TextBlock Text="DOWNLOAD DIRECTORY" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtOutput" Height="32"/>
                    <Button Grid.Column="2" Content="📁 찾아보기" Height="32" Padding="10,0" Click="BtnBrowse_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ══ Primary Action Button ══════════════════════════════════ -->
        <Button Grid.Row="10" x:Name="BtnAction"
                Content="🚀   다운로드 시작"
                Style="{StaticResource PrimaryActionButton}"
                Click="BtnAction_Click"/>

        <!-- ══ Progress Panel ══════════════════════════════════════════ -->
        <Border Grid.Row="12" Style="{StaticResource SlimCardPanel}" x:Name="ProgressPanel" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtProgressFile" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" x:Name="TxtProgressPct" Foreground="{StaticResource AccentRedBrush}" FontWeight="Bold" FontSize="12"/>
                </Grid>
                <ProgressBar x:Name="PbProgress" Margin="0,4,0,2" Height="4" Value="0" Maximum="100"/>
                <TextBlock x:Name="TxtProgressMeta" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" FontWeight="Medium"/>
            </StackPanel>
        </Border>

        <!-- ══ Terminal Log Console ════════════════════════════════════ -->
        <Border Grid.Row="14" Style="{StaticResource SlimCardPanel}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💻" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CONSOLE LOGS" Style="{StaticResource SectionHeader}" Margin="0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="지우기" Padding="6,2" FontSize="10.5" Height="22" Click="BtnClearLog_Click"/>
                    <Button Grid.Column="3" Content="복사" Padding="6,2" FontSize="10.5" Height="22" Click="BtnCopyLog_Click"/>
                </Grid>

                <TextBox Grid.Row="1" x:Name="TxtLog"
                         Background="{StaticResource ConsoleBgBrush}"
                         Foreground="#F8F9FA"
                         FontFamily="Cascadia Code, Consolas, Courier New" FontSize="10.5"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         MinHeight="80"
                         BorderThickness="0"
                         Padding="8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
