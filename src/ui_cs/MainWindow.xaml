<Window x:Class="YoutubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Downloader v2.0"
        Height="390" Width="380"
        MinHeight="350" MinWidth="350"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Header Banner -->
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>   <!-- 2: URL Input -->
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>   <!-- 4: Options -->
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>   <!-- 6: Output Folder -->
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>   <!-- 8: Action Button -->
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>   <!-- 10: Progress Panel -->
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>      <!-- 12: Terminal Log Console -->
        </Grid.RowDefinitions>

        <!-- 0: Header Banner -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource AccentRedBrush}" CornerRadius="5" Width="24" Height="24" Margin="0,0,6,0">
                    <Path Data="M 0,0 L 8,5 L 0,10 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </Border>
                <TextBlock Text="YouTube Downloader v2.0"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="❓ 도움말"
                        VerticalAlignment="Center" Padding="6,0" Height="26" FontSize="11" Margin="0,0,4,0"
                        Command="{Binding ShowHelpCommand}"/>
                <Button Content="📁 완료 폴더"
                        VerticalAlignment="Center" Padding="6,0" Height="26" FontSize="11"
                        Command="{Binding OpenCompletedFolderCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 2: URL Input Card -->
        <Border Grid.Row="2" Style="{StaticResource SlimCardPanel}" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11.5" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="📋 붙여넣기" Height="28" Padding="8,0" FontSize="11" Command="{Binding PasteUrlCommand}"/>
            </Grid>
        </Border>

        <!-- 4: Options Card (2x2 Compact) -->
        <Border Grid.Row="4" Style="{StaticResource SlimCardPanel}" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Quality & Cookie -->
                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="화질" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox Grid.Column="2" SelectedValuePath="Tag" SelectedValue="{Binding SelectedQuality, Mode=TwoWay}" Height="26" FontSize="11">
                        <ComboBoxItem Content="Best (최고)" Tag="best"/>
                        <ComboBoxItem Content="2160p (4K)" Tag="2160p"/>
                        <ComboBoxItem Content="1440p (2K)" Tag="1440p"/>
                        <ComboBoxItem Content="1080p (FHD)" Tag="1080p"/>
                        <ComboBoxItem Content="720p (HD)" Tag="720p"/>
                        <ComboBoxItem Content="480p" Tag="480p"/>
                        <ComboBoxItem Content="360p" Tag="360p"/>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="0" Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="쿠키" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox Grid.Column="2" SelectedValuePath="Content" SelectedValue="{Binding SelectedCookie, Mode=TwoWay}" Height="26" FontSize="11">
                        <ComboBoxItem Content="none"/>
                        <ComboBoxItem Content="edge"/>
                        <ComboBoxItem Content="chrome"/>
                        <ComboBoxItem Content="firefox"/>
                    </ComboBox>
                </Grid>

                <!-- Row 2: Checkboxes -->
                <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding SaveSubtitles, Mode=TwoWay}" Content="자막 (.srt)" VerticalAlignment="Center" FontSize="11"/>
                <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding ForceDownload, Mode=TwoWay}" Content="새로 받기" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>

        <!-- 6: Output Folder Card -->
        <Border Grid.Row="6" Style="{StaticResource SlimCardPanel}" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11"/>
                <Button Grid.Column="2" Content="📁 찾아보기" Height="28" Padding="8,0" FontSize="11" Command="{Binding BrowseOutputFolderCommand}"/>
            </Grid>
        </Border>

        <!-- 8: Primary Action Button -->
        <Button Grid.Row="8"
                Content="{Binding ActionButtonText}"
                Command="{Binding StartOrStopDownloadCommand}"
                Height="32"
                Style="{StaticResource PrimaryActionButton}"/>

        <!-- 10: Progress Panel -->
        <Border Grid.Row="10" Style="{StaticResource SlimCardPanel}" Padding="8,4" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProgressFile}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressPctText}" Foreground="{StaticResource AccentRedBrush}" FontWeight="Bold" FontSize="11"/>
                </Grid>
                <ProgressBar Margin="0,3,0,1" Height="3" Value="{Binding ProgressPct}" Maximum="100"/>
                <TextBlock Text="{Binding ProgressMeta}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
            </StackPanel>
        </Border>

        <!-- 12: Terminal Log Console (Ultra-Compact Log View) -->
        <Border Grid.Row="12" Style="{StaticResource SlimCardPanel}" Padding="4,3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="로그 콘솔" Style="{StaticResource SectionHeader}" Margin="0" FontSize="10" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="지우기" Padding="4,0" FontSize="9.5" Height="18" Command="{Binding ClearLogCommand}"/>
                    <Button Grid.Column="3" Content="복사" Padding="4,0" FontSize="9.5" Height="18" Command="{Binding CopyLogCommand}"/>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource ConsoleBgBrush}" CornerRadius="3" Padding="0">
                    <TextBox Text="{Binding LogText, Mode=OneWay}"
                             Background="Transparent"
                             Foreground="#F8F9FA"
                             FontFamily="Cascadia Code, Consolas, Courier New" FontSize="10"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             Margin="0"
                             Padding="4,2"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
